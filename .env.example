# ==========================================================
# PrognosX — Environment Variables (example)
# Copy this file to `.env` and fill in the values you need.
# Nothing here is required for Phases 1-3; kept here so the
# project structure matches the final architecture.
# ==========================================================

# --- Project paths (override defaults in src/config/config.py) ---
DATA_RAW_DIR=data/raw/CMAPSS
DATA_PROCESSED_DIR=data/processed
LOG_DIR=logs

# --- Logging ---
LOG_LEVEL=INFO

# --- Reserved for later phases (API / deployment) ---
# API_HOST=0.0.0.0
# API_PORT=8000
